# Generated from Settings defaults/descriptions; do not copy over an existing .env.
# Regenerate: uv run --locked python scripts/sync_settings_docs.py
# Optional values are commented out; process environment overrides .env.

# Prefer CUDA for local ASR/LLM when available; otherwise fall back to CPU. Does not install CUDA.
USE_GPU=True

# Root for resolving relative model/cache paths. Defaults to the project root; use an absolute path when overriding. Does not relocate .env.
# BASE_DIR=<absolute project root>

# Mono PCM16 capture rate in Hz. This ASR adapter requires exactly 16000.
SAMPLE_RATE=16000

# Capture/VAD frame duration in seconds: 0.01, 0.02 or 0.03 only. At 16000 Hz, 0.02 means 320 samples / 640 bytes.
CHUNK_DURATION=0.02

# Consecutive non-speech seconds required to end an utterance. Larger values delay the reply; rounded up to whole frames.
SILENCE_THRESHOLD=0.8

# WebRTC VAD aggressiveness: 0 least restrictive, 3 most restrictive speech detection. Classifies frames; does not remove noise or echo.
VAD_MODE=3

# Consecutive voiced milliseconds needed to confirm onset, rounded up to whole frames. Buffer retains these frames plus up to 200 ms of preceding audio.
SPEECH_START_MS=100

# Force an endpoint at this many seconds of emitted audio, including pre-roll and trailing silence. Rounded up to whole frames; must exceed the speech-start window.
MAX_UTTERANCE_SECONDS=30

# PyAudio input device index from verify_env.py --audio. Omit to use the system default; an empty value is not a valid integer.
# INPUT_DEVICE_INDEX=1

# Compatible FunASR streaming model alias or local model directory. An alias may download weights; the default model is Chinese-oriented.
ASR_MODEL="paraformer-zh-streaming"

# ModelScope download cache. An existing MODELSCOPE_CACHE environment variable takes precedence. Relative paths resolve under BASE_DIR.
ASR_CACHE_DIR=".cache/modelscope"

# LLM provider mode: api uses the configured compatible chat-completions endpoint; local loads existing weights.
LLM_BACKEND="api"

# Local tokenizer/model directory; set this when LLM_BACKEND=local. Files must already exist. Relative paths resolve under BASE_DIR. Unused in API mode.
LLM_MODEL_PATH=""

# HTTP(S) API base URL, including the server API prefix if required. Used only in api mode.
LLM_API_URL="http://localhost:11434/v1"

# Exact model identifier exposed by the API server; used only in api mode.
LLM_API_MODEL="waifu"

# API credential; NA is a placeholder for servers without authentication. Keep real credentials only in private environment configuration.
LLM_API_KEY="NA"

# Maximum generated tokens per response, passed to local/API generation. Tokens are not characters.
LLM_MAX_TOKENS=256

# Local prompt token budget, further limited by model context minus output budget. Drops oldest turns, retaining system/current input. Not applied to API requests.
LLM_INPUT_TOKENS=2048

# Maximum inference idle seconds before first text, between emitted text chunks, or before generation finishes, after provider preparation. Full-output-queue waits use DOWNSTREAM_TIMEOUT instead. Completed output can drain without this timeout; native cancellation remains cooperative.
LLM_TIMEOUT=90

# Maximum seconds continuously blocked on a queue handoff, or waiting for playback completion without a completed segment. Separate from inference idle and per-segment TTS/playback timeouts; cancellation remains cooperative.
DOWNSTREAM_TIMEOUT=300

# API client HTTP timeout in seconds, separate from LLM_TIMEOUT; SDK retries are disabled. Used only in api mode.
REQUEST_TIMEOUT=15

# Number of recent user-led turns retained after each response. Only completed assistant playback segments enter history; interrupted segments are omitted.
HISTORY_TURNS=15

# System instruction for each LLM request. Local placement is selected automatically from the model template; API mode keeps the system role. Empty or whitespace-only text disables it.
SYSTEM_PROMPT="You are a helpful voice assistant. Reply concisely in the language of the user."

# Edge TTS voice name. Synthesis requires internet and sends the filtered assistant text to the service.
TTS_MODEL="zh-CN-XiaoyiNeural"

# Additional synthesis attempts before playback; total attempts = 1 + this value. No retry after playback starts.
TTS_MAX_RETRIES=1

# Synthesis timeout in seconds per attempt, per text segment. Retries can multiply total wait time.
TTS_TIMEOUT=30

# Maximum compressed MP3 bytes accumulated for one segment, checked before extending the buffer. Default 16777216 = 16 MiB; not a total-process memory cap.
TTS_MAX_SEGMENT_BYTES=16777216

# Maximum playback seconds per synthesized segment; exceeds this only by polling/driver delays.
PLAYBACK_TIMEOUT=120

# Target maximum raw text characters per segment before cleanup. Split at sentence delimiters or a whitespace/hard length boundary; no timed flush.
SEGMENT_CHARS=120

# Enable speech text cleanup inside the segmenter after each segment is extracted, including the final tail. False preserves raw text; empty cleaned segments are skipped.
TEXT_FILTER_ENABLED=True

# When filtering is enabled, remove the literal symbols *, _, backtick, ~, # and >. Lightweight cleanup, not a Markdown parser; may alter code or math.
TEXT_FILTER_MARKDOWN=True

# When filtering is enabled, remove common emoji ranges, flags, modifiers, joiners, variation selectors and keycaps. Heuristic: not all Unicode emoji; some non-emoji symbols also match.
TEXT_FILTER_EMOJI=True

# When filtering is enabled, remove the common ASCII faces listed in SpeechTextFilter.EMOTICONS, including :) and :D. Case-sensitive substring matching.
TEXT_FILTER_EMOTICONS=True

# Extra literal words/characters to delete within each completed segment, as a JSON array of nonempty strings. Case-sensitive substrings, longest match first. LLM chunk splits are fine within a segment; matches across segment boundaries are not removed. No regex or word-boundary matching.
TEXT_FILTER_REMOVE='[]'

# Capture-to-ASR queue capacity in packets (audio frames plus endpoint markers). Default holds about 5 seconds at 20 ms/frame. Overflow is fatal rather than dropping speech.
AUDIO_QUEUE_FRAMES=250

# Capacity of each text queue: completed user turns and TTS segments/end markers. Producers wait when full, respecting cancellation.
TEXT_QUEUE_SIZE=8

# Manager worker-join deadline in seconds; also used separately for inference worker joins. Native calls may outlive it and are reported. Not a strict total process-exit deadline.
SHUTDOWN_TIMEOUT=5

# Cancel the current assistant response on a new nonempty completed user transcript. Explicit stop commands work even when False.
BARGE_IN=True

# Stop phrases as a JSON array. Case-insensitive literal substring matching on completed transcripts; surrounding phrase whitespace is ignored, internal spaces/punctuation are preserved. A match consumes the entire utterance and cancels active/pending replies even with BARGE_IN=False. Choose distinctive longer phrases; blank entries are invalid, [] disables verbal stop commands. Does not bypass VAD/ASR endpoint delay.
STOP_PHRASES='["先暂停一下", "停一下", "Stop it please"]'

# With BARGE_IN=True, also cancel on VAD-confirmed onset, before ASR text. Faster but sensitive to noise/echo; not acoustic echo cancellation.
BARGE_IN_ON_SPEECH_START=False
